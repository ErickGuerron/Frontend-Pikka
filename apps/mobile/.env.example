# Gateway ORIGIN only (no /api/v1 suffix). The app appends /api/v1/... itself.
# Gateway host port is GATEWAY_PORT (default 8080) in Backend-Pikka/docker-compose.yml.
#   Android emulator:                 http://10.0.2.2:8080
#   iOS simulator / web:              http://localhost:8080
#   Physical device (Expo Go, Wi-Fi): http://<LAN-IP-of-your-PC>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8081

# true = customer orders come from an in-memory DEMO adapter (the backend has no orders endpoints yet).
EXPO_PUBLIC_MOCK_CUSTOMER_ORDERS=false
